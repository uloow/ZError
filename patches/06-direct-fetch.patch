diff --git a/src/utils/directFetch.ts b/src/utils/directFetch.ts
new file mode 100644
index 0000000..715aa53
--- /dev/null
+++ b/src/utils/directFetch.ts
@@ -0,0 +1,27 @@
+/**
+ * 强制直连的 Tauri HTTP 请求选项。
+ *
+ * 背景：tauri-plugin-http 的 fetch 底层是 reqwest，默认会自动探测
+ * macOS 系统代理（Clash / Surge 等）。系统代理开着时：
+ *   - 国内 API（deepseek / 阿里百炼）偶尔被代理节点拖死，
+ *     表现为「Model call failed: Timeout waiting for model response (no new tokens)」；
+ *   - webapi.zaizhexue.top（EdgeOne CDN）直接返回 567 拦截页；
+ *   - 超星图片 CDN 被拦。
+ *
+ * 原理：reqwest 的 `ClientBuilder::proxy()` 一旦被显式调用就会关闭
+ * 自动系统代理探测（auto_sys_proxy = false，见 reqwest src/async_impl/client.rs），
+ * 再配合 `noProxy: "*"`（文档明确「`*` matches all hostnames」）对所有主机绕过代理，
+ * 等效于直连。占位 URL `http://127.0.0.1:9` 只是凑数，永远不会真正被使用。
+ *
+ * 使用范围：国内直连目标（模型 API、zaizhexue webapi、超星图片）。
+ * GitHub 等需要走代理的境外下载（updateDownload.ts）不要加这个参数。
+ */
+export const DIRECT_PROXY = {
+  all: { url: 'http://127.0.0.1:9', noProxy: '*' }
+} as const
+
+/** 带直连参数的 plugin-http fetch，签名与原 fetch 一致，直接替换调用点即可 */
+export const directFetch = async (input: RequestInfo | URL, init: RequestInit = {}): Promise<Response> => {
+  const tauriHttp = await import('@tauri-apps/plugin-http')
+  return tauriHttp.fetch(input as any, { ...init, proxy: DIRECT_PROXY } as any) as unknown as Response
+}
